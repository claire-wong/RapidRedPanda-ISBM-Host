# Source control and local tooling
.git/
.gitignore
.vs/
.agents/
.codex-build/
agentTasks/

# Projects not required to publish the Host
RapidRedPanda.ISBM.Host.Tests/
RapidRedPanda.ISBM.Host.slnx

# Build and test output
**/bin/
**/obj/
**/TestResults/
**/coverage/
**/coverage.*
**/*.coverage
**/*.coveragexml
**/*.trx
artifacts/
publish/

# IDE and operating-system files
**/*.user
**/*.suo
**/*.rsuser
**/*.userosscache
**/*.sln.docstates
**/.DS_Store
**/Thumbs.db
**/desktop.ini

# Local logs and temporary files
**/*.log
**/*.tmp
**/*.temp
**/*.bak
**/*~

# Local secrets and environment-specific configuration
.env
.env.*
**/.env
**/.env.*
**/secrets.json
**/appsettings.Development.json
**/appsettings.Development.local.json
**/appsettings.Local.json
**/appsettings.*.local.json

# Development configuration template is for local setup
**/appsettings.Development.example.json

# Local SQL Server data and development-only database scripts
Database/Active/
Database/Empty/
Database/Scripts/Migrations/
Database/Scripts/Validation/
**/*.mdf
**/*.ldf

# Certificates and private keys
**/*.pfx
**/*.p12
**/*.pem
**/*.key
**/*.crt
**/*.cer

# Generated image archives and packages
**/*.tar
**/*.tar.gz
**/*.tgz
**/*.zip
