{
  "Isbm": {
    "ConfigurationDiscovery": {
      "SecurityLevelConformance": 1,
      "AdditionalInformationUrl": "https://github.com/claire-wong/RapidRedPanda-ISBM-Host"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "PublicationNotifications": {
    "Enabled": true,
    "BatchSize": 20,
    "MaxConcurrency": 4,
    "IdlePollIntervalSeconds": 5,
    "ErrorPollIntervalSeconds": 10,
    "LeaseDurationSeconds": 60,
    "HttpTimeoutSeconds": 10,
    "MaximumAttempts": 8,
    "MaximumDeliveryAgeMinutes": 1440,
    "InitialRetryDelaySeconds": 10,
    "MaximumRetryDelaySeconds": 900,
    "BackoffMultiplier": 2.0,
    "JitterPercent": 20
  },
  "AllowedHosts": "*"
}
