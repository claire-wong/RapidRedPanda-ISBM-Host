# Documentation is local-only until final public-release review
docs/

# Prototype management projects are not part of the upcoming public release
RapidRedPanda.ISBM.Management.Web/
RapidRedPanda.ISBM.Management.Web.Tests/

# Database scripts: track production install and maintenance SQL sources
RapidRedPanda.ISBM.Host/Database/Scripts/*
!RapidRedPanda.ISBM.Host/Database/Scripts/Install/
RapidRedPanda.ISBM.Host/Database/Scripts/Install/*
!RapidRedPanda.ISBM.Host/Database/Scripts/Install/*.sql

# Maintenance scripts are source controlled
!RapidRedPanda.ISBM.Host/Database/Scripts/Maintenance/
RapidRedPanda.ISBM.Host/Database/Scripts/Maintenance/*
!RapidRedPanda.ISBM.Host/Database/Scripts/Maintenance/*.sql

# Local database working folders
RapidRedPanda.ISBM.Host/Database/Active/
RapidRedPanda.ISBM.Host/Database/Empty/

# Local database development scripts
RapidRedPanda.ISBM.Host/Database/Scripts/Migrations/
RapidRedPanda.ISBM.Host/Database/Scripts/Validation/

# Local SQL Server database files
*.mdf
*.ldf

# Local integration test logs
*.stdout.log
*.stderr.log

# Visual Studio user and workspace files
.vs/
**/.vs/
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# Build output
[Bb]in/
[Oo]bj/
**/[Bb]in/
**/[Oo]bj/

# Test results and coverage
TestResults/
**/TestResults/
coverage/
**/coverage/
coverage.*
*.coverage
*.coveragexml
*.trx

# Local environment and secret-bearing files
.env
.env.*
!.env.example
**/appsettings.Development.json
**/appsettings.Development.local.json
**/appsettings.Local.json
**/appsettings.*.local.json
**/secrets.json

# Common operating-system metadata
.DS_Store
Thumbs.db
desktop.ini
